root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.java]
indent_style = space
indent_size = 4

[*.{jsp,html,css,js,xml}]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.txt]
trim_trailing_whitespace = false
